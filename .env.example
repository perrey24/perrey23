# Configuración del Servidor Backend LexFlow Colombia
PORT=3001
NODE_ENV=development

# Proveedor de Inteligencia Artificial (Opcional)
# Si no se define una clave, LexFlow utiliza automáticamente su Motor Heurístico
# especializado en Derecho Colombiano en modo demostrativo local transparente.
# Obtenga su clave en: https://aistudio.google.com/
GEMINI_API_KEY=
